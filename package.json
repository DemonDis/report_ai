{
  "name": "git-report-ai",
  "displayName": "Git Report AI",
  "description": "Формирует отчет о изменениях в Git через AI",
  "version": "1.0.0",
  "publisher": "dimart",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitReportAI.generate",
        "title": "Git Report AI: Сформировать отчет"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
